#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <36 35 65 66 67 52 68 53 37 38 69 70 75 74 73 72 71 54 55 56 57 58 59 45 44 43 42 41 40 39 21 22 23 24 25 27 26 12 13 10 11 7 8 9>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <66 67 52 68 69 70 53 37 38 0 1 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 60 61 62 63 64 65>;
        };
    };

    macros {
        macro_macos: macro_macos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 4>;
            label = "MACRO_MACOS";
        };

        macro_work: macro_work {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 0>;
            label = "MACRO_WORK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1           &kp N2           &kp N3             &kp N4               &kp N5  &tog 1                                                &mo 3      &kp N6  &kp N7                &kp N8              &kp N9            &kp N0               &kp MINUS
&none      &kp Q            &kp W            &kp E              &kp R                &kp T   &none                                                 &none      &kp Y   &kp U                 &kp I               &kp O             &kp P                &kp BSLH
&kp CAPS   &hml LEFT_WIN A  &hml LEFT_ALT S  &hml LEFT_SHIFT D  &hml LEFT_CONTROL F  &kp G   &none     &none    &none        &none      &none      &none      &kp H   &hmr RIGHT_CONTROL J  &hmr K RIGHT_SHIFT  &hmr RIGHT_ALT L  &hmr RIGHT_WIN SEMI  &kp SQT
&none      &kp Z            &kp X            &kp C              &kp V                &kp B                      &kp TAB      &kp PG_UP                        &kp N   &kp M                 &kp COMMA           &kp DOT           &kp FSLH             &none
&mo 2      &kp GRAVE        &none            &kp LEFT           &kp RIGHT                    &kp BSPC  &kp DEL  &kp ESC      &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP                &kp DOWN            &kp LBKT          &kp RBKT             &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &macro_macos  &macro_work  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none        &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none        &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none        &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none        &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        macOS {
            bindings = <
&trans  &trans               &trans           &trans             &trans               &trans  &trans                                      &trans  &trans  &trans                &trans              &trans            &trans                   &trans
&trans  &trans               &trans           &trans             &trans               &trans  &trans                                      &trans  &trans  &trans                &trans              &trans            &trans                   &trans
&trans  &hml LEFT_CONTROL A  &hml LEFT_ALT S  &hml LEFT_SHIFT D  &hml LEFT_COMMAND F  &trans  &trans  &trans  &trans      &trans  &none   &trans  &trans  &hmr RIGHT_COMMAND J  &hmr RIGHT_SHIFT K  &hmr RIGHT_ALT L  &hmr RIGHT_CONTROL SEMI  &trans
&trans  &trans               &trans           &trans             &trans               &trans                  &trans      &trans                  &trans  &trans                &trans              &trans            &trans                   &trans
&trans  &trans               &trans           &trans             &trans                       &trans  &trans  &trans      &trans  &trans  &trans          &trans                &trans              &trans            &trans                   &trans
            >;
        };
    };
};
